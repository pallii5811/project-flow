# PROJECT FLOW environment template
# Copy to .env (never commit secrets).

# development | test | production
FLOW_APP_ENV=development

# 1 = force feed on, 0 = force off; unset = on in development, off otherwise
EXPO_PUBLIC_FEED_V0=

# Recommendation V0 (unset = on in development when FEED path is active defaults)
EXPO_PUBLIC_RECOMMENDATION_V0=
EXPO_PUBLIC_RECOMMENDATION_DIVERSITY_V0=
EXPO_PUBLIC_RECOMMENDATION_EXPLORATION_V0=

# Scene Graph ranking signals (default OFF — content intelligence only)
EXPO_PUBLIC_SCENE_GRAPH_SIGNALS_V0=

# Intent Layer (dev default ON for layer+chips; NL off)
EXPO_PUBLIC_INTENT_LAYER=
EXPO_PUBLIC_INTENT_CHIPS_V0=
EXPO_PUBLIC_INTENT_NL_V0=

# Demand Graph (default OFF — intelligence only, never blocks feed)
EXPO_PUBLIC_DEMAND_GRAPH_V0=

# Public origin of the deployed site (https, no path). Required by `npm run export:web`:
# share previews (og:image, og:url) are built from it.
NEXT_PUBLIC_SITE_URL=

# 1 = allow an export without NEXT_PUBLIC_ANALYTICS_ENDPOINT (private previews only:
# such a build measures nothing — no retention, no producer minutes).
FLOW_ALLOW_NO_ANALYTICS=

# Analytics HTTP transport (L1.5). Empty = console-only.
# Web:
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Mobile:
EXPO_PUBLIC_ANALYTICS_ENDPOINT=

# Force DEV diagnostics panel in production builds (default off)
NEXT_PUBLIC_ENABLE_DIAG=
