{
  "name": "project-flow",
  "private": true,
  "version": "0.0.0",
  "description": "PROJECT FLOW — short-drama consumer product monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @project-flow/mobile",
    "start": "npm run start -w @project-flow/mobile",
    "web": "npm run dev -w @project-flow/web",
    "web:expo": "npm run web -w @project-flow/mobile",
    "android": "npm run android -w @project-flow/mobile",
    "ios": "npm run ios -w @project-flow/mobile",
    "typecheck": "npm run typecheck -w @project-flow/shared && npm run typecheck -w @project-flow/design-system && npm run typecheck -w @project-flow/analytics && npm run typecheck -w @project-flow/ui && npm run typecheck -w @project-flow/feed-domain && npm run typecheck -w @project-flow/mobile && npm run typecheck -w @project-flow/web",
    "lint": "eslint . && node scripts/check-control-bytes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "build:web": "npm run build -w @project-flow/web",
    "build:web:stress": "node scripts/build-stress.mjs",
    "export:web": "node scripts/deploy-checks.mjs env && npm run build -w @project-flow/web && node scripts/deploy-checks.mjs export",
    "serve:web": "node scripts/serve-static.mjs apps/web/out 3100",
    "e2e:web": "node scripts/e2e-feed.mjs",
    "e2e:web:scale": "node scripts/e2e-feed.mjs --scale",
    "e2e:web:platform": "node scripts/e2e-platform.mjs",
    "ingest": "node scripts/ingest-series.mjs",
    "ingest:cloud": "node scripts/cloud-ingest.mjs",
    "ingest:scaleway": "node scripts/run-on-scaleway.mjs",
    "split": "node scripts/split-compilation.mjs",
    "check:ffmpeg": "node scripts/check-ffmpeg.mjs",
    "proof:gate": "node scripts/gate-proof.mjs",
    "proof:split": "node scripts/split-proof.mjs",
    "proof:cloud": "node scripts/cloud-proof.mjs",
    "proof:scaleway": "node scripts/scaleway-proof.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8",
    "yaml": "^2.9.1"
  }
}
